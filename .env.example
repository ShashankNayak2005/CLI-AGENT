# ==============================================================================
# CLI AGENT AI - Environment Configuration Example
# Copy this file to backend/.env (or set variables in your deployment environment)
# ==============================================================================

# Application Settings
APP_NAME=CLI Agent AI
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Groq AI Provider Settings (Required for live AI intent parsing and summarization)
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Persistent SQLite Database URL
DATABASE_URL=sqlite:///./cli_agent.db

