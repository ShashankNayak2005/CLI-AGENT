# ==============================================================================
# CLI AGENT AI - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=CLI Agent AI
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Allowed CORS Origins (comma-separated or list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq AI Provider Settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database Settings
DATABASE_URL=sqlite:///./cli_agent.db

